# ==============================================================================
# DailyDose AI - Environment Variables Template
# ==============================================================================
# Salin file ini menjadi `.env` lalu sesuaikan isinya dengan kredensial lokal Anda:
#   cp .env.example .env (atau di Windows: Copy-Item .env.example .env)
# CATATAN: File `.env` sudah masuk ke `.gitignore` agar tidak pernah ter-commit.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="DailyDose AI API"
VERSION=0.1.0

# Database Configuration (PostgreSQL Lokal Windows)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=dailydose_app
POSTGRES_PASSWORD=DailyDose2026!
POSTGRES_DB=dailydose_db

# Connection Pool Settings
DB_ECHO=False
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Optional: Override DATABASE_URL secara langsung (kosongkan untuk menggunakan variabel di atas)
# DATABASE_URL=postgresql+asyncpg://dailydose_app:isi_password_database_lokal_anda@127.0.0.1:5432/dailydose_db

# LLM Configuration (OpenAI API - dipersiapkan untuk fase berikutnya)
OPENAI_API_KEY=isi_openai_api_key_jika_sudah_ada
